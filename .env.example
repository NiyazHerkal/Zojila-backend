# Copy to .env and fill in real values for local dev. Never commit .env.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://travelgo:travelgo@localhost:5432/travelgo?schema=public"

# Redis: live location (positions, sharing timers). Redis inside WSL is reachable at localhost from Windows.
REDIS_URL="redis://localhost:6379"

# Live location: how often the app should send its position while sharing (seconds).
LOCATION_UPDATE_INTERVAL_SECONDS=10
# Presence: how long a user must stay disconnected before the group sees them go offline.
PRESENCE_OFFLINE_GRACE_MS=5000

# Auth
JWT_ACCESS_SECRET="ecbe9a9a5eed86fec86a6779d09ab9b379039d26fcc8f28cfcce7fe5d428911a"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="7b667e83eda35464b43a303b0524f1610a011c459675c236053808129bf59ffe"
JWT_REFRESH_EXPIRES_IN=30d

# Groups — base of shareable invite links (the app's deep-link / universal-link domain)
INVITE_LINK_BASE_URL="https://travelgo.app/invite"
# Live location for people outside the app (CR v1.0 change 10): links are <base>/<token>. The
# recipient page at that address is built by the web team; it calls GET /public/live/:token.
LIVE_SHARE_LINK_BASE_URL="https://travelgo.app/live"
# Most links one user can have active at once (default 5).
LIVE_SHARE_MAX_ACTIVE=

# Third-party — provision in Phase 1 (see backend/context/01_Architecture.md §5).
# Blank = not configured yet: the API keeps working and reports NOT_CONFIGURED for that feature.
# Maps are OpenStreetMap-based (no Google). PDF route overview is drawn from map tiles:
#   blank = public OpenStreetMap tiles (fine for dev / light use; see their tile usage policy),
#   a hosted OSM tile URL for production (e.g. MapTiler/Stadia, key inside the URL), or "off".
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# Nearby places (CR v1.0 change 1): OpenStreetMap's Overpass API. The public server is for light
# use and rate-limits quickly (429); set a hosted/own Overpass instance for production.
OVERPASS_URL=
# Road route for the trip map (stops joined along roads): an OSRM server. Blank = the public
# OSRM demo (router.project-osrm.org: dev only, car profile only, no SLA); set a self-hosted or
# hosted OSRM for production, or "off" for straight lines between stops. Profile default: driving.
ROUTING_URL=
ROUTING_PROFILE=
# Elevation (pin elevation + oxygen context) comes from Open-Meteo: works without a key
# (free tier = non-commercial). Set a key from an Open-Meteo commercial plan for production.
OPEN_METEO_API_KEY=
# Weather forecast per pin comes from MET Norway (api.met.no): free, commercial use allowed, no key.
# Push notifications (Firebase Cloud Messaging). Setup guide: backend/docs/FIREBASE_SETUP.md
# Blank = pushes are logged as [DEV PUSH] instead of sent. Use ONE of:
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER_API_KEY=
# Email (signup codes, password-reset codes, invites) via Brevo transactional API (https://app.brevo.com,
# SMTP & API -> API Keys). Blank key = emails are only logged. EMAIL_FROM_ADDRESS must be a verified
# Brevo sender (or on an authenticated domain).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TravelGo

# Where the app reaches this API, used to build absolute file URLs (trip `coverImageUrl`).
# Set it to the base URL the app uses (LAN IP, ngrok URL, or the real domain); restart after changing.
# Default http://localhost:<PORT>, which only works for the iOS simulator / this computer.
PUBLIC_API_URL=

# Uploaded files (expense receipts, voice messages, trip cover images). Stored on this server's disk until object storage exists.
# Relative to the backend folder; default ./uploads
UPLOAD_DIR=

# Object storage (receipts, PDFs, offline map tiles)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Security & privacy (Phase 12) ---
# Proxies to trust for the client IP (rate limiting). Blank = proxies on this machine only (e.g. ngrok).
# Behind a cloud load balancer, set the hop count (e.g. 1) or its address range.
TRUST_PROXY=
# Never true in production (the server refuses to start). The e2e/load test configs set it.
RATE_LIMIT_DISABLED=false
# Crash/error reporting. Blank = off (errors are only logged).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Data retention (hourly job). Days; blank = the defaults shown.
GROUP_DELETE_AFTER_CLOSE_DAYS=30
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
INVITE_RETENTION_DAYS=30
# Saved location history (opt-in trails). Shown to users in the opt-in notice, so change it with the notice.
LOCATION_HISTORY_RETENTION_DAYS=30
# Lets members turn location history on. Keep false in production until the age-eligibility
# approach (DPDP s.9) and the final notice with the privacy contact are approved. true on dev.
LOCATION_HISTORY_OPT_IN=false
RETENTION_JOB_DISABLED=false

# --- Closed beta & operations (Phase 13) ---
# Team-only /ops endpoints (beta metrics, feedback triage), header X-Ops-Key. Blank = those routes return 404.
# Production: at least 32 random characters.
OPS_API_KEY=
# Who receives in-app feedback by email (comma-separated). Blank = only logged.
FEEDBACK_EMAIL=
# Retention (days) for the usage counters behind the KPIs, and for feedback.
USAGE_RETENTION_DAYS=180
FEEDBACK_RETENTION_DAYS=365
# Pending migrations run at start-up. Set false when a deploy step runs them instead (several instances).
DB_MIGRATIONS_RUN=true
# Shown in /health and sent to Sentry as the release. Set by the deploy (git tag / build number).
APP_VERSION=
